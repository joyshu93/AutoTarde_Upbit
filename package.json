{
  "name": "autotrade-upbit",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal TypeScript Node modular-monolith scaffold for AutoTrade Upbit.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node dist/tests/run-all.js",
    "smoke:dryrun:readiness": "npm run build && node dist/src/smoke/dryrun-readiness.js",
    "smoke:dryrun:sync": "npm run build && node dist/src/smoke/dryrun-sync.js",
    "smoke:dryrun:operator": "npm run build && node dist/src/smoke/dryrun-operator.js",
    "smoke:dryrun:completion": "npm run build && node dist/src/smoke/dryrun-completion.js",
    "smoke:telegram:inbound": "npm run build && node dist/src/smoke/telegram-inbound-once.js",
    "smoke:live:readiness": "npm run build && node dist/src/smoke/live-readiness.js",
    "smoke:live:scheduler-preflight": "npm run build && node dist/src/smoke/live-scheduler-preflight.js",
    "backtest:positionguard": "npm run build && node dist/src/research/position-guard-public-backtest.js",
    "report:performance": "npm run build && node dist/src/research/performance-report.js",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
