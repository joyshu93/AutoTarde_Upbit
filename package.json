{
  "name": "autotrade-upbit",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal TypeScript Node modular-monolith scaffold for AutoTrade Upbit.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node dist/tests/run-all.js",
    "smoke:dryrun:readiness": "npm run build && node dist/src/smoke/dryrun-readiness.js",
    "smoke:dryrun:sync": "npm run build && node dist/src/smoke/dryrun-sync.js",
    "smoke:dryrun:operator": "npm run build && node dist/src/smoke/dryrun-operator.js",
    "smoke:dryrun:completion": "npm run build && node dist/src/smoke/dryrun-completion.js",
    "smoke:telegram:inbound": "npm run build && node dist/src/smoke/telegram-inbound-once.js",
    "smoke:live:readiness": "npm run build && node dist/src/smoke/live-readiness.js",
    "smoke:live:scheduler-preflight": "npm run build && node dist/src/smoke/live-scheduler-preflight.js",
    "provision:live-db-identity": "npm run build && node dist/src/operations/provision-live-database-identity.js",
    "backtest:positionguard": "npm run build && node dist/src/research/position-guard-public-backtest.js",
    "report:performance": "npm run build && node dist/src/research/performance-report.js",
    "report:strategy-evaluation": "npm run build && node dist/src/research/integrated-strategy-evaluation.js",
    "research:candles": "npm run build && node dist/src/research/upbit-candle-dataset.js",
    "research:no-trade-evidence": "npm run build && node dist/src/research/upbit-no-trade-evidence.js",
    "research:prospective-shadow": "npm run build && node dist/src/research/prospective-component-shadow.js",
    "inspect:btc-pilot:readiness": "npm run build && node dist/src/inspection/position-guard-pilot-readiness.js",
    "build:prospective-commitment-bundle": "esbuild ./src/research/prospective-shadow-commitment.ts --bundle --platform=node --format=esm --target=node20 --outfile=./.github/scripts/prospective-shadow-commitment.mjs --banner:js=\"// Generated validator bundle. Source: src/research/prospective-shadow-commitment.ts\"",
    "check:prospective-commitment-bundle": "node scripts/check-prospective-commitment-bundle.mjs",
    "check": "npm run typecheck && npm run check:prospective-commitment-bundle && npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "~0.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
